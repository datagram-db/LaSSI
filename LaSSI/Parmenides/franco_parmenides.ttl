@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix parmenides: <https://logds.github.io/parmenides#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

parmenides:AbstractEntity a owl:Class ;
    rdfs:subClassOf parmenides:Concept .

parmenides:Adjective a owl:Class ;
    rdfs:subClassOf parmenides:GrammaticalFunction .

parmenides:Adverb a owl:Class ;
    rdfs:subClassOf parmenides:GrammaticalFunction .

parmenides:CausativeVerb a owl:Class ;
    rdfs:subClassOf parmenides:Verb .

parmenides:ComplexPreposition a owl:Class ;
    rdfs:subClassOf parmenides:Preposition .

parmenides:CompoundForm a owl:Class ;
    rdfs:subClassOf parmenides:GrammaticalFunction .

parmenides:DemonstrativePronoun a owl:Class ;
    rdfs:subClassOf parmenides:Pronoun .

parmenides:DependantPreposition a owl:Class ;
    rdfs:subClassOf parmenides:Preposition .

parmenides:GPE a owl:Class ;
    rdfs:subClassOf parmenides:Dimensions,
        parmenides:LOC .

parmenides:IdiomaticPreposition a owl:Class ;
    rdfs:subClassOf parmenides:Preposition .

parmenides:IndefinitePronoun a owl:Class ;
    rdfs:subClassOf parmenides:Pronoun .

parmenides:InterrogativePronoun a owl:Class ;
    rdfs:subClassOf parmenides:Pronoun .

parmenides:IntransitiveVerb a owl:Class ;
    rdfs:subClassOf parmenides:Verb .

parmenides:LogicalFunction a owl:Class ;
    rdfs:comment "The sentence constructs at the logical level, similarly to English' Adverbial Phrases and Indirect Objects (https://it.wikipedia.org/wiki/Analisi_logica_della_proposizione vs. https://en.wikipedia.org/wiki/Adverbial_phrase)" ;
    rdfs:subClassOf parmenides:MetaGrammaticalFunction .

parmenides:LogicalRewritingRule a owl:Class ;
    rdfs:comment "Defines how to capture the elements within the sentence structure and rewriting them in the most appropriate way as properties of the kernel/singleton they refer to" ;
    rdfs:subClassOf parmenides:MetaGrammaticalFunction .

parmenides:MaterialisationVerb a owl:Class ;
    rdfs:subClassOf parmenides:Verb .

parmenides:MeansVerb a owl:Class ;
    rdfs:subClassOf parmenides:Verb .

parmenides:MovementVerb a owl:Class ;
    rdfs:subClassOf parmenides:Verb .

parmenides:PersonalPronoun a owl:Class ;
    rdfs:subClassOf parmenides:Pronoun .

parmenides:PrototypicalPreposition a owl:Class ;
    rdfs:subClassOf parmenides:Preposition .

parmenides:Rejectable a owl:Class ;
    rdfs:comment "Whether the edge shall be rejected in the internal rewriting pipeline" ;
    rdfs:subClassOf parmenides:GraphParse .

parmenides:RelativePronoun a owl:Class ;
    rdfs:subClassOf parmenides:Pronoun .

parmenides:SemiModalVerb a owl:Class ;
    rdfs:subClassOf parmenides:Verb .

parmenides:StateVerb a owl:Class ;
    rdfs:subClassOf parmenides:Verb .

parmenides:TransitiveVerb a owl:Class ;
    rdfs:subClassOf parmenides:Verb .

parmenides:UnitOfMeasure a owl:Class ;
    rdfs:subClassOf parmenides:Measure .

parmenides:argument a owl:ObjectProperty .

parmenides:attachTo a owl:ObjectProperty .

parmenides:composite_form_with a owl:ObjectProperty .

parmenides:d_object a owl:ObjectProperty .

parmenides:dependency a owl:Class ;
    rdfs:subClassOf parmenides:MetaGrammaticalFunction .

parmenides:hasAdjective a owl:ObjectProperty .

parmenides:logicalConstructName a owl:ObjectProperty .

parmenides:logicalConstructProperty a owl:ObjectProperty .

parmenides:subject a owl:ObjectProperty .

parmenides:Concept a owl:Class ;
    rdfs:subClassOf parmenides:GrammaticalFunction .

parmenides:GraphParse a owl:Class .

parmenides:LOC a owl:Class ;
    rdfs:subClassOf parmenides:Dimensions .

parmenides:Measure a owl:Class ;
    rdfs:subClassOf parmenides:GrammaticalFunction .

parmenides:television a parmenides:Noun ;
    rdfs:label "television"^^xsd:string ;
    parmenides:entryPoint parmenides:television ;
    parmenides:isA <https://logds.github.io/parmenides#home+entertainment> .

parmenides:Dimensions a owl:Class .

parmenides:entertainment a parmenides:Noun ;
    rdfs:label "entertainment"^^xsd:string ;
    parmenides:entryPoint parmenides:entertainment .

parmenides:house a parmenides:Noun ;
    rdfs:label "house"^^xsd:string ;
    parmenides:entryPoint parmenides:house ;
    parmenides:eqTo parmenides:home .

parmenides:pasttime a parmenides:Noun ;
    rdfs:label "pasttime"^^xsd:string ;
    parmenides:entryPoint parmenides:pasttime .

parmenides:home a parmenides:Noun ;
    rdfs:label "home"^^xsd:string ;
    parmenides:entryPoint parmenides:home ;
    parmenides:eqTo parmenides:house ;
    parmenides:locatedIn <https://logds.github.io/parmenides#home+entertainment> .

<https://logds.github.io/parmenides#home+entertainment> a parmenides:Noun ;
    rdfs:label "home entertainment"^^xsd:string ;
    parmenides:entryPoint <https://logds.github.io/parmenides#home+entertainment> ;
    parmenides:isA parmenides:entertainment,
        parmenides:pasttime ;
    parmenides:locatedIn parmenides:home .

parmenides:MetaGrammaticalFunction a owl:Class .

parmenides:Preposition a owl:Class ;
    rdfs:subClassOf parmenides:GrammaticalFunction .

parmenides:Pronoun a owl:Class .

parmenides:Noun a owl:Class ;
    rdfs:subClassOf parmenides:GrammaticalFunction .

parmenides:GrammaticalFunction a owl:Class ;
    rdfs:subClassOf parmenides:MetaGrammaticalFunction .

parmenides:Verb a owl:Class ;
    rdfs:subClassOf parmenides:GrammaticalFunction .

